# PostgreSQL: create the `bersu` database before running Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bersu?schema=public"
# Use Supabase's direct/session connection for Prisma migrations and administrative scripts.
# Keep this private; it must never start with NEXT_PUBLIC_.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bersu?schema=public"

# Generate each value with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-base64-secret"
# Must remain stable: it encrypts TOTP and AI provider credentials stored in PostgreSQL.
AUTH_ENCRYPTION_KEY="replace-with-a-different-32-byte-base64-secret"

# Local application origins. Keep both values aligned in development.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email. Optional only in development; required for production password and email flows.
EMAIL_FROM="Bersu Invest <noreply@bersuinvest.com>"
RESEND_API_KEY=""

# Required in production for distributed authentication and AI rate limiting.
# The development-only in-memory fallback is intentionally rejected in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Legacy data discovery is opt-in. The importer only writes review records when the
# explicit confirmation value is supplied; it never publishes imported content.
LEGACY_SOURCE_URL="https://www.bersuinvest.com/tr/"
LEGACY_IMPORT_CONFIRM=""

# AI provider credentials are configured in the admin UI and encrypted at rest.
# Do not add OPENAI_API_KEY, GEMINI_API_KEY, or other provider secrets here.
